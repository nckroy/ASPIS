---------------------------- MODULE SchedDonationTrace ----------------------------
(***************************************************************************)
(* Trace validation (Cirstea and others, arXiv 2404.16075): the states of *)
(* seeded runs of the Rust, crates/ksched's donation module, projected     *)
(* onto the spec's record, must start at Init and move only by the spec's *)
(* steps.  SchedDonationTraces is generated by the donation_traces test.  *)
(* A step that isn't one of Next's leaves TraceNext disabled, so TLC,     *)
(* checking for deadlock, reports it.  A first state that isn't Init would *)
(* leave TLC no initial state, which it reports as no error: the ASSUME    *)
(* fails instead, as it does for no traces.                                *)
(***************************************************************************)
EXTENDS SchedDonation, SchedDonationTraces

ASSUME /\ Len(Traces) > 0
       /\ \A j \in 1..Len(Traces) : Len(Traces[j]) > 0 /\ Traces[j][1] = InitState

VARIABLES k, i

TraceInit ==
    /\ k \in 1..Len(Traces)
    /\ i = 1
    /\ s = Traces[k][1]
    /\ s = InitState

TraceNext ==
    \/ /\ i < Len(Traces[k])
       /\ i' = i + 1
       /\ s' = Traces[k][i + 1]
       /\ UNCHANGED k
       /\ (Next \/ UNCHANGED s)
    \/ /\ i = Len(Traces[k])
       /\ UNCHANGED <<s, k, i>>

TraceSpec == TraceInit /\ [][TraceNext]_<<s, k, i>>

=============================================================================
