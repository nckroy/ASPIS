; uses: core
;
; org.example.base/1.0: the wire grammar, generated by idlc from v1.idl; don't edit (ADR 0067, rule 9).

; method 1 "ping": the request, strict
m-ping--req = %x00.00.00.00

; method 1 "ping": the reply
m-ping--rep = u8 m-ping--rep---tail
m-ping--rep---unknown = m-ping--rep---unknown-tag octets
m-ping--rep---unknown-tag = %x00 %x02-FF / %x01-FF OCTET
    ; constraint: at least 2
m-ping--rep---tail = tail-count *m-ping--rep---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-ping--rep---opt elements
m-ping--rep---opt = m-ping--rep---unknown

; point
t-point = i32 i32 t-point---tail
t-point---unknown = t-point---unknown-tag octets
t-point---unknown-tag = %x00 %x03-FF / %x01-FF OCTET
    ; constraint: at least 3
t-point---tail = tail-count *t-point---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count t-point---opt elements
t-point---opt = t-point---unknown

; point, strict
r-point = i32 i32 %x00.00.00.00

; pair
t-pair = u16 u16

; color
t-color = u8
