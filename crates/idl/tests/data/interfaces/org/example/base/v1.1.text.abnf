; SPDX-License-Identifier: MPL-2.0
; uses: core, names, json
;
; org.example.base/1.1: the canonical-text grammar, generated by idlc from v1.idl; don't edit (ADR 0063, rule 8).

; method 1 "ping": the request, strict
m-ping--args = "{" "}"
m-ping--call = %s"org.example.base/1/ping" SP id-text [ SP m-ping--args ]

; method 1 "ping": the reply
m-ping--results = "{" m-ping--results--result m-ping--results---a1 "}"
m-ping--results--result = %x22 %s"result" %x22 ":" m-ping--results--result---value
m-ping--results--result---value = json-uint
    ; constraint: at most 255
m-ping--results---unknown = %x22 "@" m-ping--results---unknown-tag %x22 ":" json-bytes
m-ping--results---unknown-tag = json-uint
    ; constraint: in 2..65535
m-ping--results---unknowns = m-ping--results---unknown *( "," m-ping--results---unknown )
m-ping--results---a1 = *1( "," m-ping--results---unknowns )
    ; constraint: ascending m-ping--results---unknown-tag
m-ping--reply = %s"ok" [ SP m-ping--results ] / outcome-word SP error-ref

; point
t-point = "{" t-point--x t-point---a1 "}"
t-point--x = %x22 %s"x" %x22 ":" t-point--x---value
t-point--x---value = "-" t-point--x---value---neg / t-point--x---value---digits
t-point--x---value---neg = json-uint-nz
    ; constraint: at most 2147483648
t-point--x---value---digits = json-uint
    ; constraint: at most 2147483647
t-point--y = %x22 %s"y" %x22 ":" t-point--y---value
t-point--y---value = "-" t-point--y---value---neg / t-point--y---value---digits
t-point--y---value---neg = json-uint-nz
    ; constraint: at most 2147483648
t-point--y---value---digits = json-uint
    ; constraint: at most 2147483647
t-point--z = %x22 %s"z" %x22 ":" t-point--z---value
t-point--z---value = "-" t-point--z---value---neg / t-point--z---value---digits
t-point--z---value---neg = json-uint-nz
    ; constraint: at most 2147483648
t-point--z---value---digits = json-uint
    ; constraint: at most 2147483647
t-point---unknown = %x22 "@" t-point---unknown-tag %x22 ":" json-bytes
t-point---unknown-tag = json-uint
    ; constraint: in 4..65535
t-point---unknowns = t-point---unknown *( "," t-point---unknown )
t-point---a1 = "," t-point--y t-point---a2
t-point---a2 = [ "," t-point--z ] t-point---a3
t-point---a3 = *1( "," t-point---unknowns )
    ; constraint: ascending t-point---unknown-tag

; point, strict
r-point = "{" r-point--x r-point---a1 "}"
r-point--x = %x22 %s"x" %x22 ":" r-point--x---value
r-point--x---value = "-" r-point--x---value---neg / r-point--x---value---digits
r-point--x---value---neg = json-uint-nz
    ; constraint: at most 2147483648
r-point--x---value---digits = json-uint
    ; constraint: at most 2147483647
r-point--y = %x22 %s"y" %x22 ":" r-point--y---value
r-point--y---value = "-" r-point--y---value---neg / r-point--y---value---digits
r-point--y---value---neg = json-uint-nz
    ; constraint: at most 2147483648
r-point--y---value---digits = json-uint
    ; constraint: at most 2147483647
r-point--z = %x22 %s"z" %x22 ":" r-point--z---value
r-point--z---value = "-" r-point--z---value---neg / r-point--z---value---digits
r-point--z---value---neg = json-uint-nz
    ; constraint: at most 2147483648
r-point--z---value---digits = json-uint
    ; constraint: at most 2147483647
r-point---a1 = "," r-point--y r-point---a2
r-point---a2 = [ "," r-point--z ]

; pair
t-pair = "{" t-pair--a "," t-pair--b "}"
t-pair--a = %x22 %s"a" %x22 ":" t-pair--a---value
t-pair--a---value = json-uint
    ; constraint: at most 65535
t-pair--b = %x22 %s"b" %x22 ":" t-pair--b---value
t-pair--b---value = json-uint
    ; constraint: at most 65535

; color
t-color---number = json-uint
    ; constraint: not one of 1, 2, 3
    ; constraint: at most 255
t-color = %x22 ( %s"red" / %s"green" / %s"blue" ) %x22 / t-color---number

; extra
t-extra = "{" t-extra--n t-extra---a1 "}"
t-extra--n = %x22 %s"n" %x22 ":" t-extra--n---value
t-extra--n---value = json-uint
    ; constraint: at most 255
t-extra--c = %x22 %s"c" %x22 ":" t-color
t-extra---unknown = %x22 "@" t-extra---unknown-tag %x22 ":" json-bytes
t-extra---unknown-tag = json-uint
    ; constraint: in 3..65535
t-extra---unknowns = t-extra---unknown *( "," t-extra---unknown )
t-extra---a1 = "," t-extra--c t-extra---a2
t-extra---a2 = *1( "," t-extra---unknowns )
    ; constraint: ascending t-extra---unknown-tag

; extra, strict
r-extra = "{" r-extra--n "," r-extra--c "}"
r-extra--n = %x22 %s"n" %x22 ":" r-extra--n---value
r-extra--n---value = json-uint
    ; constraint: at most 255
r-extra--c = %x22 %s"c" %x22 ":" t-color
