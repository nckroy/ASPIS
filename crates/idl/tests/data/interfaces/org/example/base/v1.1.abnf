; uses: core
;
; org.example.base/1.1: the wire grammar, generated by idlc from v1.idl; don't edit (ADR 0067, rule 9).

; method 1 "ping": the request, strict
m-ping--req = %x00.00.00.00

; method 1 "ping": the reply
m-ping--rep = u8 m-ping--rep---tail
m-ping--rep---unknown = m-ping--rep---unknown-tag octets
m-ping--rep---unknown-tag = %x00 %x02-FF / %x01-FF OCTET
    ; constraint: at least 2
m-ping--rep---tail = tail-count *m-ping--rep---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-ping--rep---opt elements
m-ping--rep---opt = m-ping--rep---unknown

; point
t-point = i32 i32 t-point---tail
t-point--z = %x00.03 %x00.00.00.04 i32
t-point---unknown = t-point---unknown-tag octets
t-point---unknown-tag = %x00 %x04-FF / %x01-FF OCTET
    ; constraint: at least 4
t-point---tail = tail-count *t-point---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count t-point---opt elements
t-point---opt = t-point--z / t-point---unknown

; point, strict
r-point = i32 i32 r-point---tail
r-point--z = %x00.03 %x00.00.00.04 i32
r-point---tail = tail-count *1r-point---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count r-point---opt elements
r-point---opt = r-point--z

; pair
t-pair = u16 u16

; color
t-color = u8

; extra
t-extra = u8 t-color t-extra---tail
t-extra---unknown = t-extra---unknown-tag octets
t-extra---unknown-tag = %x00 %x03-FF / %x01-FF OCTET
    ; constraint: at least 3
t-extra---tail = tail-count *t-extra---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count t-extra---opt elements
t-extra---opt = t-extra---unknown

; extra, strict
r-extra = u8 t-color %x00.00.00.00
