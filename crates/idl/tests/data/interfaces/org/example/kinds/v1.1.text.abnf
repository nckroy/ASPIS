u1--r-point--y---value---digits = json-uint
    ; constraint: at most 2147483647
u1--t-point = "{" u1--t-point--x u1--t-point---a1 "}"
u1--t-point--x = %x22 %s"x" %x22 ":" u1--t-point--x---value
u1--t-point--x---value = "-" u1--t-point--x---value---neg / u1--t-point--x---value---digits
u1--t-point--x---value---neg = json-uint-nz
    ; constraint: at most 2147483648
u1--t-point--x---value---digits = json-uint
    ; constraint: at most 2147483647
u1--t-point--y = %x22 %s"y" %x22 ":" u1--t-point--y---value
u1--t-point--y---value = "-" u1--t-point--y---value---neg / u1--t-point--y---value---digits
u1--t-point--y---value---neg = json-uint-nz
    ; constraint: at most 2147483648
u1--t-point--y---value---digits = json-uint
    ; constraint: at most 2147483647
u1--t-point---unknown = %x22 "@" u1--t-point---unknown-tag %x22 ":" json-bytes
u1--t-point---unknown-tag = json-uint
    ; constraint: in 3..65535
u1--t-point---unknowns = u1--t-point---unknown *( "," u1--t-point---unknown )
u1--t-point---a1 = "," u1--t-point--y u1--t-point---a2
u1--t-point---a2 = *1( "," u1--t-point---unknowns )
    ; constraint: ascending u1--t-point---unknown-tag
u1--t-pair = "{" u1--t-pair--a "," u1--t-pair--b "}"
u1--t-pair--a = %x22 %s"a" %x22 ":" u1--t-pair--a---value
u1--t-pair--a---value = json-uint
    ; constraint: at most 65535
u1--t-pair--b = %x22 %s"b" %x22 ":" u1--t-pair--b---value
u1--t-pair--b---value = json-uint
    ; constraint: at most 65535
