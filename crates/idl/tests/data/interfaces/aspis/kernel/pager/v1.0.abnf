; aspis.kernel.pager/1.0: the wire grammar, generated by idlc from v1.idl; don't edit (ADR 0067, rule 9).

; method 1 "page_request": the request, read tolerantly (the kernel sends it)
m-page-request--req = u64 u32 m-page-request--req---tail
m-page-request--req--access = %x00.03 %x00.00.00.01 t-access
m-page-request--req---unknown = m-page-request--req---unknown-tag octets
m-page-request--req---unknown-tag = %x00 %x04-FF / %x01-FF OCTET
    ; constraint: at least 4
m-page-request--req---tail = tail-count *m-page-request--req---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-page-request--req---opt elements
m-page-request--req---opt = m-page-request--req--access / m-page-request--req---unknown

; method 2 "query": the request, read tolerantly (the kernel sends it)
m-query--req = u64 m-query--req---tail
m-query--req---unknown = m-query--req---unknown-tag octets
m-query--req---unknown-tag = %x00 %x02-FF / %x01-FF OCTET
    ; constraint: at least 2
m-query--req---tail = tail-count *m-query--req---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-query--req---opt elements
m-query--req---opt = m-query--req---unknown

; method 2 "query": the reply
m-query--rep = u64 m-query--rep---tail
m-query--rep---unknown = m-query--rep---unknown-tag octets
m-query--rep---unknown-tag = %x00 %x02-FF / %x01-FF OCTET
    ; constraint: at least 2
m-query--rep---tail = tail-count *m-query--rep---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-query--rep---opt elements
m-query--rep---opt = m-query--rep---unknown

; access
t-access = u8

