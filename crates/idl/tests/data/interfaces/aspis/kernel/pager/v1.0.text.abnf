; uses: core, names, json
;
; aspis.kernel.pager/1.0: the canonical-text grammar, generated by idlc from v1.idl; don't edit (ADR 0063, rule 8).

; method 1 "page_request": the request, read tolerantly (the kernel sends it)
m-page-request--args = "{" m-page-request--args--offset m-page-request--args---a1 "}"
m-page-request--args--offset = %x22 %s"offset" %x22 ":" m-page-request--args--offset---value
m-page-request--args--offset---value = %x22 m-page-request--args--offset---value---digits %x22
m-page-request--args--offset---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-page-request--args--length = %x22 %s"length" %x22 ":" m-page-request--args--length---value
m-page-request--args--length---value = json-uint
    ; constraint: at most 4294967295
m-page-request--args--access = %x22 %s"access" %x22 ":" t-access
m-page-request--args---unknown = %x22 "@" m-page-request--args---unknown-tag %x22 ":" json-bytes
m-page-request--args---unknown-tag = json-uint
    ; constraint: in 4..65535
m-page-request--args---unknowns = m-page-request--args---unknown *( "," m-page-request--args---unknown )
m-page-request--args---a1 = "," m-page-request--args--length m-page-request--args---a2
m-page-request--args---a2 = [ "," m-page-request--args--access ] m-page-request--args---a3
m-page-request--args---a3 = *1( "," m-page-request--args---unknowns )
    ; constraint: ascending m-page-request--args---unknown-tag
m-page-request--call = %s"aspis.kernel.pager/1/page_request" SP id-text [ SP m-page-request--args ]

; method 2 "query": the request, read tolerantly (the kernel sends it)
m-query--args = "{" m-query--args--key m-query--args---a1 "}"
m-query--args--key = %x22 %s"key" %x22 ":" m-query--args--key---value
m-query--args--key---value = %x22 m-query--args--key---value---digits %x22
m-query--args--key---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-query--args---unknown = %x22 "@" m-query--args---unknown-tag %x22 ":" json-bytes
m-query--args---unknown-tag = json-uint
    ; constraint: in 2..65535
m-query--args---unknowns = m-query--args---unknown *( "," m-query--args---unknown )
m-query--args---a1 = *1( "," m-query--args---unknowns )
    ; constraint: ascending m-query--args---unknown-tag
m-query--call = %s"aspis.kernel.pager/1/query" SP id-text [ SP m-query--args ]

; method 2 "query": the reply
m-query--results = "{" m-query--results--result m-query--results---a1 "}"
m-query--results--result = %x22 %s"result" %x22 ":" m-query--results--result---value
m-query--results--result---value = %x22 m-query--results--result---value---digits %x22
m-query--results--result---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-query--results---unknown = %x22 "@" m-query--results---unknown-tag %x22 ":" json-bytes
m-query--results---unknown-tag = json-uint
    ; constraint: in 2..65535
m-query--results---unknowns = m-query--results---unknown *( "," m-query--results---unknown )
m-query--results---a1 = *1( "," m-query--results---unknowns )
    ; constraint: ascending m-query--results---unknown-tag
m-query--reply = %s"ok" [ SP m-query--results ] / outcome-word SP error-ref

; access
t-access---number = json-uint
    ; constraint: not one of 1, 2
    ; constraint: at most 255
t-access = %x22 ( %s"read" / %s"write" ) %x22 / t-access---number

; types the use lines import, read at the minor each names
