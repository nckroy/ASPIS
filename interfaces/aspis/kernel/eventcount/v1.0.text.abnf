; uses: core, names, json
;
; aspis.kernel.eventcount/1.0: the canonical-text grammar, generated by idlc from v1.idl; don't edit (ADR 0063, rule 8).

; method 1 "advance": the request, strict
m-advance--args = "{" "}"
m-advance--call = %s"aspis.kernel.eventcount/1/advance" SP "-" [ SP m-advance--args ]

; method 1 "advance": the reply
m-advance--results = "{" m-advance--results--result m-advance--results---a1 "}"
m-advance--results--result = %x22 %s"result" %x22 ":" m-advance--results--result---value
m-advance--results--result---value = %x22 m-advance--results--result---value---digits %x22
m-advance--results--result---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-advance--results---unknown = %x22 "@" m-advance--results---unknown-tag %x22 ":" json-bytes
m-advance--results---unknown-tag = json-uint
    ; constraint: in 2..65535
m-advance--results---unknowns = m-advance--results---unknown *( "," m-advance--results---unknown )
m-advance--results---a1 = *1( "," m-advance--results---unknowns )
    ; constraint: ascending m-advance--results---unknown-tag
m-advance--reply = %s"ok" [ SP m-advance--results ] / outcome-word SP error-ref

; method 2 "wait": the request, strict
m-wait--args = "{" m-wait--args--target m-wait--args---a1 "}"
m-wait--args--target = %x22 %s"target" %x22 ":" m-wait--args--target---value
m-wait--args--target---value = %x22 m-wait--args--target---value---digits %x22
m-wait--args--target---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-wait--args--deadline = %x22 %s"deadline" %x22 ":" m-wait--args--deadline---value
m-wait--args--deadline---value = %x22 m-wait--args--deadline---value---digits %x22
m-wait--args--deadline---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-wait--args---a1 = [ "," m-wait--args--deadline ]
m-wait--call = %s"aspis.kernel.eventcount/1/wait" SP "-" [ SP m-wait--args ]

; method 2 "wait": the reply
m-wait--results = "{" m-wait--results--result m-wait--results---a1 "}"
m-wait--results--result = %x22 %s"result" %x22 ":" m-wait--results--result---value
m-wait--results--result---value = %x22 m-wait--results--result---value---digits %x22
m-wait--results--result---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-wait--results---unknown = %x22 "@" m-wait--results---unknown-tag %x22 ":" json-bytes
m-wait--results---unknown-tag = json-uint
    ; constraint: in 2..65535
m-wait--results---unknowns = m-wait--results---unknown *( "," m-wait--results---unknown )
m-wait--results---a1 = *1( "," m-wait--results---unknowns )
    ; constraint: ascending m-wait--results---unknown-tag
m-wait--reply = %s"ok" [ SP m-wait--results ] / outcome-word SP error-ref

; method 3 "read": the request, strict
m-read--args = "{" "}"
m-read--call = %s"aspis.kernel.eventcount/1/read" SP "-" [ SP m-read--args ]

; method 3 "read": the reply
m-read--results = "{" m-read--results--result m-read--results---a1 "}"
m-read--results--result = %x22 %s"result" %x22 ":" m-read--results--result---value
m-read--results--result---value = %x22 m-read--results--result---value---digits %x22
m-read--results--result---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-read--results---unknown = %x22 "@" m-read--results---unknown-tag %x22 ":" json-bytes
m-read--results---unknown-tag = json-uint
    ; constraint: in 2..65535
m-read--results---unknowns = m-read--results---unknown *( "," m-read--results---unknown )
m-read--results---a1 = *1( "," m-read--results---unknowns )
    ; constraint: ascending m-read--results---unknown-tag
m-read--reply = %s"ok" [ SP m-read--results ] / outcome-word SP error-ref

; error "overflow": its detail
e-overflow = "{" *1( e-overflow---unknowns ) "}"
    ; constraint: ascending e-overflow---unknown-tag
e-overflow---unknown = %x22 "@" e-overflow---unknown-tag %x22 ":" json-bytes
e-overflow---unknown-tag = json-uint
    ; constraint: in 1..65535
e-overflow---unknowns = e-overflow---unknown *( "," e-overflow---unknown )
