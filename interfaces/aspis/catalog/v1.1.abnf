; aspis.catalog/1.1: the wire grammar, generated by idlc from v1.idl; don't edit (ADR 0067, rule 9).

; method 1 "list": the request, strict
m-list--req = r-query m-list--req---tail
m-list--req--page = %x00.02 m-list--req--page---len m-list--req--page---body
m-list--req--page---value = m-list--req--page---value---len *64OCTET
    ; constraint: exactly m-list--req--page---value---len octets
m-list--req--page---value---len = len32
    ; constraint: at most 64
m-list--req--page---len = len32
    ; constraint: in 4..68
m-list--req--page---body = m-list--req--page---value
    ; constraint: exactly m-list--req--page---len octets
m-list--req---tail = tail-count *1m-list--req---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-list--req---opt elements
m-list--req---opt = m-list--req--page

; method 1 "list": the reply
m-list--rep = u64 m-list--rep--entries m-list--rep---tail
m-list--rep--entries = m-list--rep--entries---count *256object-id
    ; constraint: exactly m-list--rep--entries---count object-id elements
m-list--rep--entries---count = count32
    ; constraint: at most 256
m-list--rep--next-page = %x00.03 m-list--rep--next-page---len m-list--rep--next-page---body
m-list--rep--next-page---value = m-list--rep--next-page---value---len *64OCTET
    ; constraint: exactly m-list--rep--next-page---value---len octets
m-list--rep--next-page---value---len = len32
    ; constraint: at most 64
m-list--rep--next-page---len = len32
    ; constraint: in 4..68
m-list--rep--next-page---body = m-list--rep--next-page---value
    ; constraint: exactly m-list--rep--next-page---len octets
m-list--rep---unknown = m-list--rep---unknown-tag octets
m-list--rep---unknown-tag = %x00 %x04-FF / %x01-FF OCTET
    ; constraint: at least 4
m-list--rep---tail = tail-count *m-list--rep---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-list--rep---opt elements
m-list--rep---opt = m-list--rep--next-page / m-list--rep---unknown

; method 2 "watch": the request, strict
m-watch--req = r-query m-watch--req---tail
m-watch--req--after = %x00.02 %x00.00.00.08 u64
m-watch--req---tail = tail-count *1m-watch--req---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-watch--req---opt elements
m-watch--req---opt = m-watch--req--after

; method 2 "watch": the reply
m-watch--rep = u64 m-watch--rep---tail
m-watch--rep---unknown = m-watch--rep---unknown-tag octets
m-watch--rep---unknown-tag = %x00 %x02-FF / %x01-FF OCTET
    ; constraint: at least 2
m-watch--rep---tail = tail-count *m-watch--rep---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-watch--rep---opt elements
m-watch--rep---opt = m-watch--rep---unknown

; method 2 "watch": the opening reply: its stream ID, start position and reply struct
m-watch--open = m-watch--open---id u64 m-watch--rep
m-watch--open---id = u32
    ; constraint: not 0

; method 2 "watch": a stream item
m-watch--item = t-change

; method 3 "register": the request, strict
m-register--req = cap-ref u32 m-register--req--proof m-register--req---tail
m-register--req--proof = m-register--req--proof---len *8192text-char
    ; constraint: exactly m-register--req--proof---len octets
m-register--req--proof---len = len32
    ; constraint: at most 8192
m-register--req--dry-run = %x00.04 %x00.00.00.01 bool
m-register--req---tail = tail-count *1m-register--req---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-register--req---opt elements
m-register--req---opt = m-register--req--dry-run

; method 3 "register": the reply
m-register--rep = u64 m-register--rep---tail
m-register--rep---unknown = m-register--rep---unknown-tag octets
m-register--rep---unknown-tag = %x00 %x02-FF / %x01-FF OCTET
    ; constraint: at least 2
m-register--rep---tail = tail-count *m-register--rep---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count m-register--rep---opt elements
m-register--rep---opt = m-register--rep---unknown

; error "query_too_broad": its detail
e-query-too-broad = u32 e-query-too-broad---tail
e-query-too-broad---unknown = e-query-too-broad---unknown-tag octets
e-query-too-broad---unknown-tag = %x00 %x02-FF / %x01-FF OCTET
    ; constraint: at least 2
e-query-too-broad---tail = tail-count *e-query-too-broad---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count e-query-too-broad---opt elements
e-query-too-broad---opt = e-query-too-broad---unknown

; error "already_registered": its detail
e-already-registered = e-already-registered---tail
e-already-registered---unknown = e-already-registered---unknown-tag octets
e-already-registered---unknown-tag = %x00 %x01-FF / %x01-FF OCTET
    ; constraint: at least 1
e-already-registered---tail = tail-count *e-already-registered---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count e-already-registered---opt elements
e-already-registered---opt = e-already-registered---unknown

; change_kind
t-change-kind = u8

; change
t-change = u64 t-change-kind object-id t-change---tail
t-change--publisher = %x00.04 %x00.00.00.20 object-id
t-change---unknown = t-change---unknown-tag octets
t-change---unknown-tag = %x00 %x05-FF / %x01-FF OCTET
    ; constraint: at least 5
t-change---tail = tail-count *t-change---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count t-change---opt elements
t-change---opt = t-change--publisher / t-change---unknown

; change, strict
r-change = u64 t-change-kind object-id r-change---tail
r-change--publisher = %x00.04 %x00.00.00.20 object-id
r-change---tail = tail-count *1r-change---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count r-change---opt elements
r-change---opt = r-change--publisher

; interface_req
t-interface-req = object-id u16 u16

; selector
t-selector = t-selector--by-id / t-selector--by-name / t-selector--by-interface / t-selector---unknown
t-selector--by-id = %x00.01 %x00.00.00.20 object-id
t-selector--by-name = %x00.02 t-selector--by-name---len t-selector--by-name---body
t-selector--by-name---value = t-selector--by-name---value---len *255text-char
    ; constraint: exactly t-selector--by-name---value---len octets
t-selector--by-name---value---len = len32
    ; constraint: at most 255
t-selector--by-name---len = len32
    ; constraint: in 4..259
t-selector--by-name---body = t-selector--by-name---value
    ; constraint: exactly t-selector--by-name---len octets
t-selector--by-interface = %x00.03 %x00.00.00.24 t-interface-req
t-selector---unknown = t-selector---unknown-tag octets
t-selector---unknown-tag = %x00 %x04-FF / %x01-FF OCTET
    ; constraint: not one of 0, 1, 2, 3

; query
t-query = t-selector t-query---tail
t-query--limit = %x00.02 %x00.00.00.04 u32
t-query---unknown = t-query---unknown-tag octets
t-query---unknown-tag = %x00 %x03-FF / %x01-FF OCTET
    ; constraint: at least 3
t-query---tail = tail-count *t-query---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count t-query---opt elements
t-query---opt = t-query--limit / t-query---unknown

; query, strict
r-query = t-selector r-query---tail
r-query--limit = %x00.02 %x00.00.00.04 u32
r-query---tail = tail-count *1r-query---opt
    ; constraint: ascending tags
    ; constraint: exactly tail-count r-query---opt elements
r-query---opt = r-query--limit

