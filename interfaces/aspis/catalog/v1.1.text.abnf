t-interface-req--min-minor = %x22 %s"min_minor" %x22 ":" t-interface-req--min-minor---value
t-interface-req--min-minor---value = json-uint
    ; constraint: at most 65535

; selector
t-selector = "{" ( t-selector--by-id / t-selector--by-name / t-selector--by-interface / t-selector---unknown ) "}"
t-selector--by-id = %x22 %s"by_id" %x22 ":" json-id
t-selector--by-name = %x22 %s"by_name" %x22 ":" json-string
t-selector--by-interface = %x22 %s"by_interface" %x22 ":" t-interface-req
t-selector---unknown = %x22 "@" t-selector---unknown-tag %x22 ":" json-bytes
t-selector---unknown-tag = json-uint
    ; constraint: not one of 0, 1, 2, 3
    ; constraint: at most 65535

; query
t-query = "{" t-query--select t-query---a1 "}"
t-query--select = %x22 %s"select" %x22 ":" t-selector
t-query--limit = %x22 %s"limit" %x22 ":" t-query--limit---value
t-query--limit---value = json-uint
    ; constraint: at most 4294967295
t-query---unknown = %x22 "@" t-query---unknown-tag %x22 ":" json-bytes
t-query---unknown-tag = json-uint
    ; constraint: in 3..65535
t-query---unknowns = t-query---unknown *( "," t-query---unknown )
t-query---a1 = [ "," t-query--limit ] t-query---a2
t-query---a2 = *1( "," t-query---unknowns )
    ; constraint: ascending t-query---unknown-tag

; query, strict
r-query = "{" r-query--select r-query---a1 "}"
