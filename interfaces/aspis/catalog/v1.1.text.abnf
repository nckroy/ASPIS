; aspis.catalog/1.1: the canonical-text grammar, generated by idlc from v1.idl; don't edit (ADR 0063, rule 8).

; method 1 "list": the request, strict
m-list--args = "{" m-list--args--query m-list--args---a1 "}"
m-list--args--query = %x22 %s"query" %x22 ":" r-query
m-list--args--page = %x22 %s"page" %x22 ":" m-list--args--page---value
m-list--args--page---value = %x22 ( *20json-b64-4 [ json-b64-2 / json-b64-3 ] / 21json-b64-4 [ json-b64-2 ] ) %x22
m-list--args---a1 = [ "," m-list--args--page ]
m-list--call = %s"aspis.catalog/1/list" SP id-text [ SP m-list--args ]

; method 1 "list": the reply
m-list--results = "{" m-list--results--at m-list--results---a1 "}"
m-list--results--at = %x22 %s"at" %x22 ":" m-list--results--at---value
m-list--results--at---value = %x22 m-list--results--at---value---digits %x22
m-list--results--at---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-list--results--entries = %x22 %s"entries" %x22 ":" m-list--results--entries---value
m-list--results--entries---value = "[" [ json-id *255( "," json-id ) ] "]"
m-list--results--next-page = %x22 %s"next_page" %x22 ":" m-list--results--next-page---value
m-list--results--next-page---value = %x22 ( *20json-b64-4 [ json-b64-2 / json-b64-3 ] / 21json-b64-4 [ json-b64-2 ] ) %x22
m-list--results---unknown = %x22 "@" m-list--results---unknown-tag %x22 ":" json-bytes
m-list--results---unknown-tag = json-uint
    ; constraint: in 4..65535
m-list--results---unknowns = m-list--results---unknown *( "," m-list--results---unknown )
m-list--results---a1 = "," m-list--results--entries m-list--results---a2
m-list--results---a2 = [ "," m-list--results--next-page ] m-list--results---a3
m-list--results---a3 = *1( "," m-list--results---unknowns )
    ; constraint: ascending m-list--results---unknown-tag
m-list--reply = %s"ok" [ SP m-list--results ] / outcome-word SP error-ref

; method 2 "watch": the request, strict
m-watch--args = "{" m-watch--args--query m-watch--args---a1 "}"
m-watch--args--query = %x22 %s"query" %x22 ":" r-query
m-watch--args--after = %x22 %s"after" %x22 ":" m-watch--args--after---value
m-watch--args--after---value = %x22 m-watch--args--after---value---digits %x22
m-watch--args--after---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-watch--args---a1 = [ "," m-watch--args--after ]
m-watch--call = %s"aspis.catalog/1/watch" SP id-text [ SP m-watch--args ]

; method 2 "watch": the reply
m-watch--results = "{" m-watch--results--at m-watch--results---a1 "}"
m-watch--results--at = %x22 %s"at" %x22 ":" m-watch--results--at---value
m-watch--results--at---value = %x22 m-watch--results--at---value---digits %x22
m-watch--results--at---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-watch--results---unknown = %x22 "@" m-watch--results---unknown-tag %x22 ":" json-bytes
m-watch--results---unknown-tag = json-uint
    ; constraint: in 2..65535
m-watch--results---unknowns = m-watch--results---unknown *( "," m-watch--results---unknown )
m-watch--results---a1 = *1( "," m-watch--results---unknowns )
    ; constraint: ascending m-watch--results---unknown-tag
m-watch--reply = %s"ok" [ SP m-watch--results ] / outcome-word SP error-ref

; method 2 "watch": the opening reply: its stream ID, start position and reply struct

; method 2 "watch": a stream item
m-watch--item = t-change

; method 3 "register": the request, strict
m-register--args = "{" m-register--args--definition m-register--args---a1 "}"
m-register--args--definition = %x22 %s"definition" %x22 ":" json-cap
m-register--args--length = %x22 %s"length" %x22 ":" m-register--args--length---value
m-register--args--length---value = json-uint
    ; constraint: at most 4294967295
m-register--args--proof = %x22 %s"proof" %x22 ":" json-null
m-register--args--dry-run = %x22 %s"dry_run" %x22 ":" json-bool
m-register--args---a1 = "," m-register--args--length m-register--args---a2
m-register--args---a2 = "," m-register--args--proof m-register--args---a3
m-register--args---a3 = [ "," m-register--args--dry-run ]
m-register--call = %s"aspis.catalog/1/register" SP id-text [ SP m-register--args ]

; method 3 "register": the reply
m-register--results = "{" m-register--results--result m-register--results---a1 "}"
m-register--results--result = %x22 %s"result" %x22 ":" m-register--results--result---value
m-register--results--result---value = %x22 m-register--results--result---value---digits %x22
m-register--results--result---value---digits = json-uint
    ; constraint: at most 18446744073709551615
m-register--results---unknown = %x22 "@" m-register--results---unknown-tag %x22 ":" json-bytes
m-register--results---unknown-tag = json-uint
    ; constraint: in 2..65535
m-register--results---unknowns = m-register--results---unknown *( "," m-register--results---unknown )
m-register--results---a1 = *1( "," m-register--results---unknowns )
    ; constraint: ascending m-register--results---unknown-tag
m-register--reply = %s"ok" [ SP m-register--results ] / outcome-word SP error-ref

; error "query_too_broad": its detail
e-query-too-broad = "{" e-query-too-broad--limit e-query-too-broad---a1 "}"
e-query-too-broad--limit = %x22 %s"limit" %x22 ":" e-query-too-broad--limit---value
e-query-too-broad--limit---value = json-uint
    ; constraint: at most 4294967295
e-query-too-broad---unknown = %x22 "@" e-query-too-broad---unknown-tag %x22 ":" json-bytes
e-query-too-broad---unknown-tag = json-uint
    ; constraint: in 2..65535
e-query-too-broad---unknowns = e-query-too-broad---unknown *( "," e-query-too-broad---unknown )
e-query-too-broad---a1 = *1( "," e-query-too-broad---unknowns )
    ; constraint: ascending e-query-too-broad---unknown-tag

; error "already_registered": its detail
e-already-registered = "{" *1( e-already-registered---unknowns ) "}"
    ; constraint: ascending e-already-registered---unknown-tag
e-already-registered---unknown = %x22 "@" e-already-registered---unknown-tag %x22 ":" json-bytes
e-already-registered---unknown-tag = json-uint
    ; constraint: in 1..65535
e-already-registered---unknowns = e-already-registered---unknown *( "," e-already-registered---unknown )

; change_kind
t-change-kind---number = json-uint
    ; constraint: not one of 1, 2, 3, 4
    ; constraint: at most 255
t-change-kind = %x22 ( %s"registered" / %s"withdrawn" / %s"available" / %s"unavailable" ) %x22 / t-change-kind---number

; change
t-change = "{" t-change--seq t-change---a1 "}"
t-change--seq = %x22 %s"seq" %x22 ":" t-change--seq---value
t-change--seq---value = %x22 t-change--seq---value---digits %x22
t-change--seq---value---digits = json-uint
    ; constraint: at most 18446744073709551615
t-change--kind = %x22 %s"kind" %x22 ":" t-change-kind
t-change--entry = %x22 %s"entry" %x22 ":" json-id
t-change--publisher = %x22 %s"publisher" %x22 ":" json-id
t-change---unknown = %x22 "@" t-change---unknown-tag %x22 ":" json-bytes
t-change---unknown-tag = json-uint
    ; constraint: in 5..65535
t-change---unknowns = t-change---unknown *( "," t-change---unknown )
t-change---a1 = "," t-change--kind t-change---a2
t-change---a2 = "," t-change--entry t-change---a3
t-change---a3 = [ "," t-change--publisher ] t-change---a4
t-change---a4 = *1( "," t-change---unknowns )
    ; constraint: ascending t-change---unknown-tag

; change, strict
r-change = "{" r-change--seq r-change---a1 "}"
r-change--seq = %x22 %s"seq" %x22 ":" r-change--seq---value
r-change--seq---value = %x22 r-change--seq---value---digits %x22
r-change--seq---value---digits = json-uint
    ; constraint: at most 18446744073709551615
r-change--kind = %x22 %s"kind" %x22 ":" t-change-kind
r-change--entry = %x22 %s"entry" %x22 ":" json-id
r-change--publisher = %x22 %s"publisher" %x22 ":" json-id
r-change---a1 = "," r-change--kind r-change---a2
r-change---a2 = "," r-change--entry r-change---a3
r-change---a3 = [ "," r-change--publisher ]

; interface_req
t-interface-req = "{" t-interface-req--interface "," t-interface-req--major "," t-interface-req--min-minor "}"
t-interface-req--interface = %x22 %s"interface" %x22 ":" json-id
t-interface-req--major = %x22 %s"major" %x22 ":" t-interface-req--major---value
t-interface-req--major---value = json-uint
