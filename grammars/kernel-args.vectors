#
# Test vectors for kernel-args.abnf (ADR 0041, rule 5).
#
# Each vector is one line: "ok" or "err", a tab, then the command line.
# "ok" means the whole line is accepted: it matches kernel-args and is at
# most 4096 bytes. "err" means it is not.
#
# The command line is written with C-style escapes: \t, \\, \" and \xHH.
# Any other backslash sequence is an error in this file. Trailing spaces
# are written as \x20 so editors don't strip them.
# Every other byte stands for itself, so a raw UTF-8 character is allowed.
# Lines starting with "#", and empty lines, are ignored.

# Empty lines and spaces (kernel-args).
ok	
ok	\x20
ok	\x20\x20\x20\x20
ok	a
ok	\x20\x20a\x20\x20
ok	a b
ok	a     b
ok	\x20a  b  c\x20
err	\tb
err	a\tb
err	a\t
err	a\x00
err	a\x0d\x0a
err	a\x0a

# Keys (key, segment, lower).
ok	console
ok	console.cell
ok	log.level
ok	a.b.c.d
ok	a1
ok	a-
ok	a-1.b--2
ok	x9.y-z
ok	z
err	Console
err	cOnsole
err	a.B
err	a.
err	.a
err	a..b
err	1a
err	a.1b
err	-a
err	a.-b
err	a_b
err	a:b
err	a/b
err	a"b"
err	é
err	a\xc3\xa9
err	\xff

# Bare values (bare, bare-char).
ok	console=fb
ok	console=fb,uart
ok	console.cell=24
ok	initfs=\\aspis\\a\\initfs.img
ok	initfs=/EFI/aspis/a/initfs.img
ok	a=b=c
ok	a==
ok	a=!
ok	a=~
ok	a=\\
err	a=x\\"
err	a=
err	a=\x20
err	a= b
err	=b
err	=
err	a=b"c
err	a=b"
err	a=\x7f
err	a=b\x7f
err	a=\x80
err	a=caf\xc3\xa9

# Quoted values (quoted, q-char, escape).
ok	a=""
ok	a=" "
ok	a="hello world"
ok	a="  spaced  "\x20
ok	a="\\""
ok	a="\\\\"
ok	a="say \\"hi\\" \\\\o/"
ok	a="!#$%&'()*+,-./:;<=>?@[]^_`{|}~"
ok	a="=" b=c
ok	root.name="a b" console=fb
err	a="
err	a="abc
err	a="abc\\"
err	a="abc\\\\\\"
err	a="\\n"
err	a="\\x"
err	a="\\ "
err	a="\t"
err	a="\\t"
err	a="x"y
err	a="x""y"
err	a="x"=
err	a="caf\xc3\xa9"
err	a="\x7f"
err	a="\x01"

# Several arguments and repeats.
ok	console=fb console.cell=32 log.level=debug log.size=64k
ok	a=1 a=2 a=3
ok	a a a
ok	root.x="1" root.x=2 root.x
ok	test.case=boot.smoke
err	a=1 B=2
err	a=1 b=2 c=\x22
err	a=1 b=2\tc=3

# Length: 4096 bytes is the most accepted (ADR 0041, rule 5). The grammar
# itself has no limit, so each "err" line below matches kernel-args.
ok	
err	
ok	                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               a
err	                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                a
ok	
err	
