# ---- Capability references (constraint: capability index) ----
# A core rule's match is a fragment of a body: each index is checked
# against the count, but an index the fragment doesn't name isn't missing.
# With no directive the count is 0, so no index is valid.
errc@cap-ref	\x00
# caps: 2
ok@cap-ref	\x00
ok@cap-ref	\x01
errc@cap-ref	\x02
err@cap-ref	\x03
err@cap-ref	\xff
# A position delivered unwrapped still has its index.
# unwrapped: 1
